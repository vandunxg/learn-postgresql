{{#if navigation.length}}
<ul class="nav-list" data-depth="{{or level 0}}">
  {{#each navigation}}
    {{#if ./content}}
      <li class="nav-item{{#if (eq ./url @root.page.url)}} is-current-page{{/if}}">
        {{#if ./url}}
          <a class="nav-link" href="{{#if (eq ./urlType 'internal')}}{{{relativize ./url}}}{{else}}{{{./url}}}{{/if}}">{{{./content}}}</a>
        {{else}}
          <span class="nav-text">{{{./content}}}</span>
        {{/if}}
        {{> nav-tree navigation=./items level=(increment ../level)}}
      </li>
    {{else}}
      {{> nav-tree navigation=./items level=(increment ../level)}}
    {{/if}}
  {{/each}}
</ul>
{{/if}}
